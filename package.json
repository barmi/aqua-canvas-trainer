{
  "name": "aqua-canvas-trainer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "iPad and Apple Pencil watercolor practice web app",
  "scripts": {
    "test": "vitest run --dir src",
    "assets:generate": "node scripts/generate-scenes.mjs",
    "assets:verify": "node scripts/verify-assets.mjs",
    "icons:generate": "node scripts/generate-icons.mjs",
    "build:verify": "node scripts/verify-build.mjs",
    "build:verify:pages": "node scripts/verify-build.mjs --base=/aqua-canvas-trainer/",
    "dev": "vite",
    "dev:ipad": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "build:pages": "npm run typecheck && vite build --mode github-pages",
    "preview": "vite preview",
    "preview:pages": "vite preview --mode github-pages",
    "assets:preview": "node scripts/preview-scene.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.10",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^27.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^3.2.7"
  }
}
