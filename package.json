{
  "name": "aqua-canvas-trainer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "iPad and Apple Pencil watercolor practice web app",
  "scripts": {
    "assets:generate": "node scripts/generate-scenes.mjs",
    "assets:verify": "node scripts/verify-assets.mjs",
    "dev": "vite",
    "dev:ipad": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
